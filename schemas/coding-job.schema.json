{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ghosty-11/hermes-omp-broker/main/schemas/coding-job.schema.json",
  "title": "Hermes to OMP broker wire protocol",
  "description": "Protocol v1 invoke and read-only status request and response frames. Authentication and repository, caller, model, sandbox, timeout, path, tool, and credential authorization remain server-owned policy.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/statusRequest" },
    { "$ref": "#/$defs/statusSuccess" },
    { "$ref": "#/$defs/statusError" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "request_id",
        "task_id",
        "repository",
        "caller",
        "workspace",
        "sandbox",
        "model",
        "prompt",
        "timeout"
      ],
      "properties": {
        "version": { "const": 1 },
        "request_id": { "$ref": "#/$defs/id" },
        "task_id": { "$ref": "#/$defs/id" },
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "description": "Server-owned allowlist key, never a filesystem path."
        },
        "caller": { "type": "string", "minLength": 1, "maxLength": 128 },
        "workspace": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "sandbox": { "type": "string", "minLength": 1, "maxLength": 64 },
        "model": { "type": "string", "minLength": 1, "maxLength": 512 },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 500000 },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "exit_code",
        "stdout",
        "stderr",
        "timed_out",
        "process_group_clear",
        "final",
        "request_id"
      ],
      "properties": {
        "version": { "const": 1 },
        "exit_code": { "type": "integer" },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "timed_out": { "type": "boolean" },
        "process_group_clear": { "type": "boolean" },
        "final": {
          "oneOf": [
            { "$ref": "#/$defs/final" },
            { "type": "null" }
          ]
        },
        "request_id": { "type": "string", "maxLength": 128 }
      }
    },
    "statusRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "op", "request_id", "caller", "repository"],
      "properties": {
        "version": { "const": 1 },
        "op": { "const": "status" },
        "request_id": { "$ref": "#/$defs/id" },
        "caller": { "type": "string", "minLength": 1, "maxLength": 128 },
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "description": "Server-owned allowlist key, never a filesystem path."
        }
      }
    },
    "statusSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "op", "ok", "job"],
      "properties": {
        "version": { "const": 1 },
        "op": { "const": "status" },
        "ok": { "const": true },
        "job": { "$ref": "#/$defs/statusJob" }
      }
    },
    "statusError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "op", "ok", "error"],
      "properties": {
        "version": { "const": 1 },
        "op": { "const": "status" },
        "ok": { "const": false },
        "error": { "const": "job unavailable" }
      }
    },
    "statusJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "task_id",
        "repository",
        "caller",
        "status",
        "result",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "request_id": { "$ref": "#/$defs/id" },
        "task_id": { "$ref": "#/$defs/id" },
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "caller": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": {
          "enum": [
            "pending",
            "running",
            "completed",
            "failed",
            "rejected",
            "cancelled",
            "timed_out",
            "orphaned",
            "delivery_failed"
          ]
        },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/response" },
            { "type": "null" }
          ]
        },
        "created_at": { "type": "integer", "minimum": 0 },
        "updated_at": { "type": "integer", "minimum": 0 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "lines", "severity", "issue", "fix"],
      "properties": {
        "file": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 10000000 }
        },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "issue": { "type": "string", "minLength": 4, "maxLength": 2000 },
        "fix": { "type": "string", "minLength": 4, "maxLength": 2000 }
      }
    },
    "final": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "verification", "gaps", "verdict"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "verification": {
          "type": "array",
          "items": { "type": "string" }
        },
        "gaps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "verdict": {
          "enum": ["MET", "PARTIALLY MET", "NOT MET"]
        },
        "served_model": { "type": "string", "minLength": 1, "maxLength": 512 },
        "findings": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/finding" }
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    }
  }
}
